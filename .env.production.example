# Replace YOUR_SERVER_IP with the public IP (or domain) of this host.
# Example: ALLOWED_HOSTS=203.0.113.10,localhost,127.0.0.1
ALLOWED_HOSTS=34.56.143.114,localhost,127.0.0.1

# Required for login/forms when browsing via IP (scheme + host, no trailing slash).
# Example: CSRF_TRUSTED_ORIGINS=http://203.0.113.10
CSRF_TRUSTED_ORIGINS=http://34.56.143.114

# Public site URL used in reminder emails (no trailing slash)
SITE_URL=http://34.56.143.114

# Database (used by compose + Django)
POSTGRES_DB=devmastery
POSTGRES_USER=devmastery
POSTGRES_PASSWORD=07pIcd4BLUaiqTIUswaK9MXdSd6Oy3Shski9Rs54oR
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis / Celery (overridden inside compose for service DNS; keep for clarity)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# HTTP only via server IP (set True only after HTTPS/TLS is configured)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Public port on the host (80 is standard for web access)
HTTP_PORT=80

# Gunicorn
GUNICORN_WORKERS=3

# Seed curriculum on first boot (set FORCE_SEED=1 to refresh content banks)
FORCE_SEED=0
SKIP_SEED=0

# Email digests — real SMTP (never commit real passwords)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
